# ESP32-C3 桌面墨水屏信息站 — 默认 sdkconfig
# target 必须写成带引号的字符串形式，cmake 才会识别（esp-idf/tools/cmake/targets.cmake）
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# 自定义分区表：app 1.5MB + littlefs ~2.4MB（见 partitions.csv / architecture.md）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 日志走 USB Serial/JTAG；UART0（GPIO20/21）留给 VG6328A 蓝牙模块
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

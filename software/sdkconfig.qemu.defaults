# QEMU 专用覆盖：QEMU 只把 UART0 接到 stdio，日志必须走 UART0 才看得见。
# 用法见 docs/desk-eink-info/qemu-验证.md
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# QEMU 不模拟 ADC 自校准，跳过 input（否则 adc_oneshot_new_unit 死循环）
CONFIG_APP_SKIP_INPUT=y

# QEMU 不模拟墨水屏 SPI，跳过 eink 初始化
CONFIG_APP_SKIP_EINK=y

# 仿真巡视：开机走遍所有 UI 状态，并把 framebuffer 以 base64 导出
CONFIG_APP_QEMU_TOUR=y
CONFIG_APP_QEMU_DUMP_B64=y

# ---------- 构建产物（占空间大头，绝不上库）----------
software/build/
pc-tool/bin/
pc-tool/obj/
bin/
obj/

# ---------- ESP-IDF ----------
software/sdkconfig
software/sdkconfig.old
software/managed_components/

# ---------- 压缩包（体积大，需要时另行分发）----------
*.zip
*.rar
*.7z

# ---------- 网页存档（外部资料，含大量图片）----------
*_files/

# ---------- 规格书拆图（可从 PDF 重新生成）----------
docs/desk-eink-info/depg0420-docs/

# ---------- 临时文件与日志 ----------
*.log
*.tmp
*.bak

# ---------- IDE 本地配置 ----------
.vscode/c_cpp_properties.json

# ---------- Python ----------
*.pyc
__pycache__/

# ---------- 编辑器临时文件 ----------
*.bkp
*.bkp.bak
*~
.$*

# ---------- QEMU 构建目录 ----------
software/build-qemu/
software/sdkconfig.qemu
software/sdkconfig.qemu.old

# ---------- 第三方测试素材 ----------

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeskInk.PcTool.Pages.QuotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：来源设置  -->
        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="每日一言" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="PushQuoteSwitch" Header="随课表推送" />

                    <ComboBox
                        x:Name="QuoteSourceCombo"
                        Header="来源"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="QuoteSourceCombo_SelectionChanged">
                        <ComboBoxItem Content="公益源（一言 hitokoto）" Tag="Hitokoto" />
                        <ComboBoxItem Content="手动填写" Tag="Manual" />
                        <ComboBoxItem Content="自定义网址" Tag="Url" />
                        <ComboBoxItem Content="本地文件" Tag="File" />
                    </ComboBox>

                    <TextBox
                        x:Name="QuoteBox"
                        AcceptsReturn="True"
                        Header="手动内容"
                        TextWrapping="Wrap" />

                    <TextBox
                        x:Name="QuoteUrlBox"
                        Header="自定义网址（JSON 取 hitokoto/text/content/data/quote，否则取首行文本）" />

                    <Grid x:Name="QuoteFileRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuoteFileBox" Header="本地文件路径（每行一条，按天轮换）" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Click="BrowseQuoteFile_Click"
                            Content="浏览…" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Click="Save_Click"
                            Content="保存"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="Fetch_Click" Content="立即获取" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="每天取一条，跨天自动刷新；联网源不可用时用内置备用文案兜底。"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  右：当前一言  -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="当前一言" />

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="24">
                    <TextBlock
                        x:Name="QuoteText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="26"
                        Text="尚未获取"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>

                <TextBlock
                    x:Name="SourceText"
                    Grid.Row="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="来源：—" />
            </Grid>
        </Border>
    </Grid>
</Page>

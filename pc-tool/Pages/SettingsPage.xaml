<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeskInk.PcTool.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="串口" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="PortCombo" MinWidth="220" PlaceholderText="选择串口" />
                        <Button Click="RefreshPorts_Click" Content="刷新" />
                        <Button Click="OpenPort_Click" Content="打开" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoDetectSwitch" Header="自动发现端口（仅一个 COM 口时自动打开）" />
                    <TextBlock x:Name="PortHintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="推送策略" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="PushOnEventSwitch" Header="事件触发推送（上课 / 课间 / 放学 / 时间点变化）" />
                    <ToggleSwitch x:Name="PeriodicSwitch" Header="定时补推" />
                    <NumberBox
                        x:Name="PeriodicSecondsBox"
                        Header="补推间隔（秒）"
                        Maximum="3600"
                        Minimum="10"
                        SpinButtonPlacementMode="Compact" />
                    <ToggleSwitch x:Name="PushTodoSwitch" Header="随课表推送待办" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="新闻" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="PushNewsSwitch" Header="随课表推送新闻" />
                    <ComboBox
                        x:Name="NewsSourceCombo"
                        Header="来源"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="NewsSourceCombo_SelectionChanged">
                        <ComboBoxItem Content="RSS / Atom" Tag="Rss" />
                        <ComboBoxItem Content="自定义网址" Tag="Url" />
                        <ComboBoxItem Content="本地文件" Tag="File" />
                        <ComboBoxItem Content="手动填写" Tag="Manual" />
                    </ComboBox>
                    <TextBox x:Name="NewsFeedUrlBox" Header="RSS / Atom 网址" />
                    <TextBox x:Name="NewsUrlBox" Header="自定义网址（JSON 取 title/headline/text/content/body/data，否则取首行）" />
                    <Grid x:Name="NewsFileRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewsFileBox" Header="本地文件路径（每行一条，按天轮换）" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Click="BrowseNewsFile_Click"
                            Content="浏览…" />
                    </Grid>
                    <TextBox
                        x:Name="NewsManualBox"
                        AcceptsReturn="True"
                        Header="手动填写"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="RefreshNews_Click" Content="立即刷新" />
                        <Button Click="PushNews_Click" Content="推送到设备" />
                        <TextBlock
                            x:Name="NewsStatusText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="NewsPreviewText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="尚未获取"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设备配置" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="刷新档位" />
                        <TextBlock x:Name="CfgRefreshText" Grid.Column="1" Text="—" />

                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="番茄钟专注" />
                        <TextBlock
                            x:Name="CfgPomoFocusText"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="—" />

                        <TextBlock
                            Grid.Row="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="番茄钟休息" />
                        <TextBlock
                            x:Name="CfgPomoBreakText"
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="—" />

                        <TextBlock
                            Grid.Row="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="小窗轮换" />
                        <TextBlock
                            x:Name="CfgRotateText"
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="—" />

                        <TextBlock
                            Grid.Row="4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="插画显示" />
                        <TextBlock
                            x:Name="CfgArtModeText"
                            Grid.Row="4"
                            Grid.Column="1"
                            Text="—" />

                        <TextBlock
                            Grid.Row="5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="信息条" />
                        <TextBlock
                            x:Name="CfgBarModeText"
                            Grid.Row="5"
                            Grid.Column="1"
                            Text="—" />
                    </Grid>

                    <TextBlock
                        x:Name="CfgSyncText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="最近同步：—" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="启动" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="AutoStartSwitch" Header="开机自启（注册表 Run 项）" />
                    <ToggleSwitch x:Name="StartMinimizedSwitch" Header="启动时最小化到托盘" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="Save_Click" Content="保存" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="SavedText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

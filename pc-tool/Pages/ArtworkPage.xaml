<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeskInk.PcTool.Pages.ArtworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DeskInk.PcTool.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：列表  -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="插画" />
                <ComboBox
                    x:Name="ModeCombo"
                    Header="目标尺寸"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="ModeCombo_SelectionChanged">
                    <ComboBoxItem Content="全屏 400×300" Tag="FullScreen" />
                    <ComboBoxItem Content="小窗 134×200" Tag="SmallWindow" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ImportButton" Click="Import_Click" Content="导入图片…" />
                    <Button x:Name="RemoveButton" Click="Remove_Click" Content="移除" />
                </StackPanel>
            </StackPanel>

            <ListView
                x:Name="ArtworkList"
                Grid.Row="1"
                SelectionChanged="ArtworkList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArtworkEntry">
                        <Grid Padding="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="56"
                                Height="42"
                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                Stretch="Uniform" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SizeText, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyHintText"
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="还没有插画，先导入一张图片。"
                TextWrapping="Wrap" />
        </Grid>

        <!--  右：裁剪 + 预览 + 参数  -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  裁剪编辑器  -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="CropHintText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="裁剪" />
                        <Canvas
                            x:Name="CropCanvas"
                            Grid.Row="1"
                            Background="Transparent"
                            PointerCanceled="CropCanvas_PointerCanceled"
                            PointerCaptureLost="CropCanvas_PointerCaptureLost"
                            PointerMoved="CropCanvas_PointerMoved"
                            PointerPressed="CropCanvas_PointerPressed"
                            PointerReleased="CropCanvas_PointerReleased"
                            SizeChanged="CropCanvas_SizeChanged">
                            <Image
                                x:Name="CropImage"
                                IsHitTestVisible="False"
                                Stretch="Fill" />
                            <Path
                                x:Name="CropShade"
                                Fill="#66000000"
                                IsHitTestVisible="False" />
                            <Rectangle
                                x:Name="CropRectVisual"
                                IsHitTestVisible="False"
                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                StrokeThickness="2" />
                            <Rectangle
                                x:Name="HandleTopLeft"
                                Width="12"
                                Height="12"
                                Fill="White"
                                IsHitTestVisible="False"
                                Stroke="Black"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="HandleTopRight"
                                Width="12"
                                Height="12"
                                Fill="White"
                                IsHitTestVisible="False"
                                Stroke="Black"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="HandleBottomLeft"
                                Width="12"
                                Height="12"
                                Fill="White"
                                IsHitTestVisible="False"
                                Stroke="Black"
                                StrokeThickness="1" />
                            <Rectangle
                                x:Name="HandleBottomRight"
                                Width="12"
                                Height="12"
                                Fill="White"
                                IsHitTestVisible="False"
                                Stroke="Black"
                                StrokeThickness="1" />
                        </Canvas>
                    </Grid>
                </Border>

                <!--  1-bit 预览  -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="PreviewTitleText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="1-bit 预览" />
                        <Grid
                            x:Name="PreviewHost"
                            Grid.Row="1"
                            SizeChanged="PreviewHost_SizeChanged">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="FitCombo"
                            Header="缩放方式"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="FitCombo_SelectionChanged">
                            <ComboBoxItem Content="手动裁剪" Tag="Manual" />
                            <ComboBoxItem Content="拉伸" Tag="Stretch" />
                            <ComboBoxItem Content="留白" Tag="Contain" />
                        </ComboBox>
                        <NumberBox
                            x:Name="ThresholdBox"
                            Grid.Column="1"
                            Header="阈值（0..255，关抖动时生效）"
                            Maximum="255"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="ThresholdBox_ValueChanged" />
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="16">
                            <ToggleSwitch
                                x:Name="DitherSwitch"
                                Header="抖动"
                                Toggled="DitherSwitch_Toggled" />
                            <ToggleSwitch
                                x:Name="InvertSwitch"
                                Header="反色"
                                Toggled="InvertSwitch_Toggled" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="UploadButton"
                            Click="Upload_Click"
                            Content="上传到设备"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="CancelButton"
                            Click="Cancel_Click"
                            Content="取消"
                            IsEnabled="False" />
                        <Button
                            x:Name="ExportButton"
                            Click="Export_Click"
                            Content="导出…" />
                        <ProgressBar
                            x:Name="UploadProgressBar"
                            Width="180"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="UploadStatusText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeskInk.PcTool.Pages.TodoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DeskInk.PcTool.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：编辑  -->
        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="待办" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="NewTodoBox"
                            KeyDown="NewTodoBox_KeyDown"
                            PlaceholderText="输入待办，回车添加（单条 ≤ 14 个汉字）" />
                        <Button
                            Grid.Column="1"
                            Click="Add_Click"
                            Content="添加"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <TextBlock
                        x:Name="HintText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="0 / 8 条" />

                    <ListView
                        x:Name="TodoList"
                        MaxHeight="420"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoItem">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        Click="TodoCheck_Click"
                                        IsChecked="{x:Bind Done}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Text}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="2"
                                        Click="Delete_Click"
                                        Content="删除" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Click="Push_Click"
                            Content="推送到设备"
                            Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="待办分片发送（每片 2 条，帧长 &lt; 255 字节）。设备上勾选后会回传，PC 列表跟着变。"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  右：设备预览  -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="设备预览" />
                <Grid
                    x:Name="PreviewHost"
                    Grid.Row="1"
                    SizeChanged="PreviewHost_SizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
